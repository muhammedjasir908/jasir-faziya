# Local Postgres from docker compose. For Neon, use the pooled URL here
# and the direct (non-pooler) URL as DIRECT_URL. Include sslmode=require on Neon.
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding?sslmode=disable
DIRECT_URL=postgresql://wedding:wedding@localhost:5432/wedding?sslmode=disable

# Long random string. Guests links are encrypted with this key.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

ADMIN_EMAIL=family@example.com
ADMIN_PASSWORD=replace-this-password
ADMIN_NAME=Family Admin

# Public site URL used in invitation links, WhatsApp messages, and QR codes.
APP_URL=https://jasir-faziya.vercel.app

# Used when reading event times. India has no daylight saving.
WEDDING_TIMEZONE=Asia/Kolkata
