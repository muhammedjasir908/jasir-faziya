generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvitationType {
  BOTH_EVENTS
  RECEPTION_ONLY
}

enum InvitationStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Guest {
  id             String           @id @default(cuid())
  name           String
  phone          String?
  invitationType InvitationType   @map("invitation_type")
  maxAttendees   Int              @default(1) @map("max_attendees")
  status         InvitationStatus @default(ACTIVE)
  tokenHash      String           @unique @map("token_hash")
  tokenCipher    String           @map("token_cipher")
  expiresAt      DateTime?        @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  eventAccess GuestEventAccess[]
  rsvps       GuestRSVP[]

  @@index([invitationType])
  @@index([status])
  @@map("guests")
}

model Event {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  date      DateTime? @db.Date
  timeLabel String?   @map("time_label")
  venue     String?
  address   String?
  mapUrl    String?   @map("map_url")
  notes     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  access GuestEventAccess[]
  rsvps  GuestRSVP[]

  @@map("events")
}

model GuestEventAccess {
  id        String   @id @default(cuid())
  guestId   String   @map("guest_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([guestId, eventId])
  @@index([eventId])
  @@map("guest_event_access")
}

model GuestRSVP {
  id            String     @id @default(cuid())
  guestId       String     @map("guest_id")
  eventId       String     @map("event_id")
  status        RsvpStatus
  attendeeCount Int        @default(0) @map("attendee_count")
  message       String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([guestId, eventId])
  @@index([eventId, status])
  @@map("guest_rsvps")
}

model CelebrationReply {
  id            String     @id @default(cuid())
  name          String
  nameKey       String     @map("name_key")
  eventSlug     String     @map("event_slug")
  status        RsvpStatus
  attendeeCount Int        @default(0) @map("attendee_count")
  message       String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([nameKey, eventSlug])
  @@index([eventSlug, status])
  @@map("celebration_replies")
}
